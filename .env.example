# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Connection URI (optional in sandbox; defaults to persistent local MongoDB-compatible adapter when unreachable)
MONGODB_URI="mongodb://localhost:27017/routeback"

# JWT Secret for signing authentication tokens (override in production)
JWT_SECRET="routeback-dev-jwt-secret-change-in-production"

# Google Maps Platform API Key (configured via AI Studio or Google Cloud Console)
VITE_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# Server Port (must be 3000 for AI Studio preview)
PORT=3000
